{
  "name": "KryptoAnzeigen.de - Deutschlands Krypto-Marktplatz",
  "short_name": "KryptoAnzeigen",
  "description": "Deutschlands führende Plattform für sichere Krypto-Kleinanzeigen. Kaufen und verkaufen Sie Bitcoin, Ethereum und andere Kryptowährungen von verifizierten Nutzern.",
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  "orientation": "portrait-primary",
  "scope": "/",
  "categories": ["finance", "business", "productivity", "shopping"],
  "lang": "de-DE",
  "dir": "ltr",
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+kryptoanzeigen",
      "url": "/ad/%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Anzeige erstellen",
      "short_name": "Erstellen",
      "description": "Neue Krypto-Anzeige schnell erstellen",
      "url": "/create-ad",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Anzeigen durchsuchen",
      "short_name": "Suchen",
      "description": "Alle verfügbaren Anzeigen durchsuchen",
      "url": "/browse",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Meine Favoriten",
      "short_name": "Favoriten",
      "description": "Gespeicherte Favoriten anzeigen",
      "url": "/favorites",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard", 
      "short_name": "Profil",
      "description": "Persönliches Dashboard und Profil",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/create-ad",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}